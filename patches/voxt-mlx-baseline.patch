+// logDraftStats records speculative decoding acceptance length and, when
+// OMNI_DFLASH_PROFILE=1, the draft vs target timing breakdown.
+func logDraftStats(l *lease, r *finalResult) {
+	if r == nil || r.verifyRounds <= 0 {
+		return
+	}
+	avgAccept := float64(r.acceptedDraft) / float64(r.verifyRounds)
+	avgStep := 1.0 + avgAccept
+	rate := 0.0
+	if r.proposedDraft > 0 {
+		rate = 100.0 * float64(r.acceptedDraft) / float64(r.proposedDraft)
+	}
+	msg := fmt.Sprintf("%s: dflash rounds=%d proposed=%d accepted=%d accept_rate=%.1f%% avg_accept=%.2f avg_step=%.2f",
+		l.s.spec.ID, r.verifyRounds, r.proposedDraft, r.acceptedDraft, rate, avgAccept, avgStep)
+	if total := r.draftMs + r.targetMs + r.draftContextMs; total > 0 {
+		msg += fmt.Sprintf(" | draft=%.1fms (%.1f%%) target=%.1fms (%.1f%%) ctx=%.1fms (%.1f%%)",
+			r.draftMs, 100.0*r.draftMs/total,
+			r.targetMs, 100.0*r.targetMs/total,
+			r.draftContextMs, 100.0*r.draftContextMs/total)
+		l.s.rt.logf("warning", "%s", msg)
+		return
+	}
+	l.s.rt.logf("info", "%s", msg)
+}
