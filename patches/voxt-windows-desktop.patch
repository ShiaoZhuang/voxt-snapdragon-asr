diff --git a/Voxt/internal/models/snapdragon.go b/Voxt/internal/models/snapdragon.go
new file mode 100644
index 0000000..d13f260
--- /dev/null
+++ b/Voxt/internal/models/snapdragon.go
@@ -0,0 +1,29 @@
+package models
+
+import (
+	"os"
+	"path/filepath"
+)
+
+// The launcher verifies the GGUF assets before opening the desktop app.
+// They stay in the verification package's directory, outside the model hub.
+func snapdragonModels() map[string]string {
+	dir := os.Getenv("VOXT_SNAPDRAGON_MODELS")
+	if !filepath.IsAbs(dir) {
+		return nil
+	}
+	has := func(name string) bool {
+		info, err := os.Stat(filepath.Join(dir, name))
+		return err == nil && info.Mode().IsRegular() && info.Size() > 0
+	}
+	if !has("target.gguf") || !has("mmproj.gguf") {
+		return nil
+	}
+	found := map[string]string{ASRAccurate: dir}
+	if has("draft-4.gguf") {
+		found[ASRAccurateDraft] = dir
+	}
+	return found
+}
+
+func (m *Manager) Packaged(id string) bool { return m.packaged[id] != "" }
diff --git a/Voxt/internal/models/volume_unix.go b/Voxt/internal/models/volume_unix.go
