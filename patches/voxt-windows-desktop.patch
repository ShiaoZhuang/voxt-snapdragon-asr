index 0000000..af074b8
--- /dev/null
+++ b/Voxt/internal/models/volume_unix.go
@@ -0,0 +1,24 @@
+//go:build !windows
+
+package models
+
+import (
+	"os"
+	"syscall"
+)
+
+// SameVolume reports whether a and b are folders on one volume, where
+// a model is hard-linked instead of copied.
+func SameVolume(a, b string) bool {
+	sa, err := os.Stat(a)
+	if err != nil {
+		return false
+	}
+	sb, err := os.Stat(b)
+	if err != nil {
+		return false
+	}
+	da, ok := sa.Sys().(*syscall.Stat_t)
+	db, ok2 := sb.Sys().(*syscall.Stat_t)
+	return ok && ok2 && da.Dev == db.Dev
+}
diff --git a/Voxt/internal/models/volume_windows.go b/Voxt/internal/models/volume_windows.go
new file mode 100644
index 0000000..92a472f
--- /dev/null
+++ b/Voxt/internal/models/volume_windows.go
@@ -0,0 +1,23 @@
+package models
+
+import (
+	"os"
+	"syscall"
+)
+
+// Read the volume serial from open directories to account for mount points.
+func SameVolume(a, b string) bool {
+	volume := func(path string) (uint32, bool) {
+		dir, err := os.Open(path)
+		if err != nil {
+			return 0, false
+		}
+		defer dir.Close()
+		var info syscall.ByHandleFileInformation
+		err = syscall.GetFileInformationByHandle(syscall.Handle(dir.Fd()), &info)
+		return info.VolumeSerialNumber, err == nil
+	}
+	av, aok := volume(a)
+	bv, bok := volume(b)
+	return aok && bok && av == bv
+}
