+package childprocess
+
+import (
+	"os/exec"
+	"syscall"
+)
+
+// A supervised console executable writes to pipes and must not open a console
+// on top of the text field the user is dictating into.
+func Background(cmd *exec.Cmd) {
+	const createNoWindow = 0x08000000
+	cmd.SysProcAttr = &syscall.SysProcAttr{CreationFlags: createNoWindow}
+}
