diff --git a/Voxt/settings_disk_unix.go b/Voxt/settings_disk_unix.go
new file mode 100644
index 0000000..e6d71bc
--- /dev/null
+++ b/Voxt/settings_disk_unix.go
@@ -0,0 +1,23 @@
+//go:build !windows
+
+package main
+
+import (
+	"path/filepath"
+	"syscall"
+)
+
+// diskFree is the space free for the user on path's disk (a variable:
+// snapshots pin it, snapshot_env_test.go).
+var diskFree = func(path string) int64 {
+	var st syscall.Statfs_t
+	for p := path; p != "" && p != "/" && p != "."; p = filepath.Dir(p) {
+		if syscall.Statfs(p, &st) == nil {
+			return int64(st.Bavail) * int64(st.Bsize)
+		}
+	}
+	if syscall.Statfs("/", &st) == nil {
+		return int64(st.Bavail) * int64(st.Bsize)
+	}
+	return 0
+}
diff --git a/Voxt/settings_disk_windows.go b/Voxt/settings_disk_windows.go
new file mode 100644
index 0000000..27ac047
--- /dev/null
+++ b/Voxt/settings_disk_windows.go
@@ -0,0 +1,26 @@
+package main
+
+import (
+	"path/filepath"
+	"syscall"
+	"unsafe"
+)
+
+var getDiskFreeSpace = syscall.NewLazyDLL("kernel32.dll").NewProc("GetDiskFreeSpaceExW")
+
+var diskFree = func(path string) int64 {
+	for p := filepath.Clean(path); ; p = filepath.Dir(p) {
+		name, err := syscall.UTF16PtrFromString(p)
+		if err != nil {
+			return 0
+		}
+		var available uint64
+		ok, _, _ := getDiskFreeSpace.Call(uintptr(unsafe.Pointer(name)), uintptr(unsafe.Pointer(&available)), 0, 0)
+		if ok != 0 {
+			return int64(available)
+		}
+		if filepath.Dir(p) == p {
+			return 0
+		}
+	}
+}
