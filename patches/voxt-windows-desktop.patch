--- /dev/null
+++ b/Voxt/internal/models/volume_windows.go
@@ -0,0 +1,23 @@
+package models
+
+import (
+	"os"
+	"syscall"
+)
+
+// Read the volume serial from open directories to account for mount points.
+func SameVolume(a, b string) bool {
+	volume := func(path string) (uint32, bool) {
+		dir, err := os.Open(path)
+		if err != nil {
+			return 0, false
+		}
+		defer dir.Close()
+		var info syscall.ByHandleFileInformation
+		err = syscall.GetFileInformationByHandle(syscall.Handle(dir.Fd()), &info)
+		return info.VolumeSerialNumber, err == nil
+	}
+	av, aok := volume(a)
+	bv, bok := volume(b)
+	return aok && bok && av == bv
+}
