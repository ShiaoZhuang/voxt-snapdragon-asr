+	keys := s.Features.Transcribe.Hotkeys
+	if s.Version < 6 && len(keys) == 1 && oldDefault(keys[0], "Control+Option+Space") {
+		keys[0] = Hotkey{Keys: DefaultTranscribe, Trigger: TriggerTap}
+	}
+}
