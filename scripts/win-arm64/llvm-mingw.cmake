set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR ARM64)
set(CMAKE_C_COMPILER "$ENV{VOXT_LLVM_MINGW}/bin/aarch64-w64-mingw32-clang")
set(CMAKE_CXX_COMPILER "$ENV{VOXT_LLVM_MINGW}/bin/aarch64-w64-mingw32-clang++")
set(CMAKE_RC_COMPILER "$ENV{VOXT_LLVM_MINGW}/bin/aarch64-w64-mingw32-windres")
set(CMAKE_FIND_ROOT_PATH "$ENV{VOXT_LLVM_MINGW}/aarch64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
